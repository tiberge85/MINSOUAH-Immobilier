rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth()  { return request.auth != null; }
    function uid()     { return request.auth.uid; }

    function userRole() {
      return firestore.get(/databases/(default)/documents/users/$(uid())).data.role;
    }

    function isManager()   { return isAuth() && userRole() in ['ADMIN','MANAGER']; }
    function isStaff()     { return isAuth() && userRole() in ['ADMIN','MANAGER','ACCOUNTANT','TECHNICIAN','CONCIERGE']; }

    function isImage()       { return request.resource.contentType.matches('image/.*'); }
    function isDocument()    { return request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf'; }
    function maxSize(mb)     { return request.resource.size <= mb * 1024 * 1024; }

    // ── Avatars utilisateurs ──────────────────────────────────────────────────
    match /orgs/{orgId}/profiles/{fileName} {
      allow read:  if isAuth();
      allow write: if isAuth() && isImage() && maxSize(5);
    }

    // ── Photos de biens immobiliers ───────────────────────────────────────────
    match /orgs/{orgId}/properties/{propId}/{fileName} {
      allow read:  if isAuth();
      allow write: if isManager() && isImage() && maxSize(10);
    }

    // ── Documents de contrats (PDF, scans) ────────────────────────────────────
    match /orgs/{orgId}/contracts/{contractId}/{fileName} {
      allow read:  if isAuth();
      allow write: if isManager() && isDocument() && maxSize(20);
    }

    // ── Quittances et reçus générés ───────────────────────────────────────────
    match /orgs/{orgId}/receipts/{fileName} {
      allow read:  if isAuth();
      allow write: if isStaff() && isDocument() && maxSize(10);
    }

    // ── Photos et rapports de maintenance ─────────────────────────────────────
    match /orgs/{orgId}/maintenance/{ticketId}/{fileName} {
      allow read:  if isAuth();
      allow write: if isStaff() && isDocument() && maxSize(20);
    }

    // ── États des lieux (photos, PDF) ─────────────────────────────────────────
    match /orgs/{orgId}/inspections/{inspId}/{fileName} {
      allow read:  if isAuth();
      allow write: if isStaff() && isDocument() && maxSize(20);
    }

    // ── Documents locataires (CNI, justificatifs) ─────────────────────────────
    match /orgs/{orgId}/tenants/{tenantId}/{fileName} {
      allow read:  if isManager();
      allow write: if isManager() && isDocument() && maxSize(10);
    }

    // ── Documents généraux ────────────────────────────────────────────────────
    match /orgs/{orgId}/documents/{fileName} {
      allow read:  if isStaff();
      allow write: if isManager() && maxSize(25);
    }
  }
}
