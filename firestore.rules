rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Workspace-scoped data ────────────────────────────────────────────────
    // All app data lives under workspaces/{wsId}/...
    // Access requires Firebase Auth (including anonymous auth used by the app).
    // Role-based enforcement is handled by the UI; rules enforce authentication only.

    match /workspaces/{wsId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // ── Deny everything else ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
