rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function callerMeta(wsId) {
      let p = /databases/$(database)/documents/workspaces/$(wsId)/usersByUid/$(request.auth.uid);
      return exists(p) ? get(p).data : {};
    }
    function callerRole(wsId)  { return callerMeta(wsId).get('role', ''); }
    function callerOrgId(wsId) { return callerMeta(wsId).get('orgId', ''); }

    function isSuperAdmin(wsId) { return callerRole(wsId) == 'SUPER_ADMIN'; }

    function isOrgAdmin(wsId) {
      return callerRole(wsId) in ['ORGANIZATION_ADMIN', 'ADMIN'];
    }

    function isStaff(wsId) {
      return callerRole(wsId) in [
        'ORGANIZATION_ADMIN', 'AGENT',
        'ADMIN', 'MANAGER', 'CONCIERGE', 'TECHNICIAN', 'ACCOUNTANT'
      ];
    }

    function sameOrg(wsId, docOrgId) {
      return callerOrgId(wsId) == docOrgId;
    }

    function orgIdOf(resource, request) {
      return resource == null ? request.resource.data.orgId : resource.data.orgId;
    }

    // Non-anonymous authenticated user with a verified email address.
    // Called before writing to sensitive live collections (organizations, licenses, users).
   function isVerifiedNonAnon() {
  return request.auth != null
         && request.auth.token.firebase.sign_in_provider != 'anonymous';
}

    // ── usersByUid — written at login ─────────────────────────────────────────
    match /workspaces/{wsId}/usersByUid/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && isSuperAdmin(wsId);
    }

    // ── Organizations ─────────────────────────────────────────────────────────
    // Read: SUPER_ADMIN, staff (anonymous OK via usersByUid), or verified email users.
    // Create: verified email (self-registration) OR SUPER_ADMIN.
    // Update/delete: SUPER_ADMIN only.
    match /workspaces/{wsId}/organizations/{orgId} {
      allow read:   if request.auth != null
                    && (isSuperAdmin(wsId) || isStaff(wsId)
                        || request.auth.token.firebase.sign_in_provider != 'anonymous');
      allow create: if isVerifiedNonAnon()
                    || (request.auth != null && isSuperAdmin(wsId));
      allow update, delete: if request.auth != null && isSuperAdmin(wsId);
    }

    // ── Pending organizations (held in limbo until email is verified) ─────────
    // Created immediately after Firebase Auth account is made (email_verified: false OK).
    // Only the creating user can read or delete their own pending record.
    match /workspaces/{wsId}/pendingOrganizations/{orgId} {
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow read, delete: if request.auth != null
                          && request.auth.uid == resource.data.fbUid;
      allow update: if false;
    }

    // ── Licenses ──────────────────────────────────────────────────────────────
    // Read: SUPER_ADMIN, staff (anonymous OK via usersByUid), or verified email users.
    match /workspaces/{wsId}/licenses/{licId} {
      allow read:   if request.auth != null
                    && (isSuperAdmin(wsId) || isStaff(wsId)
                        || request.auth.token.firebase.sign_in_provider != 'anonymous');
      allow create: if isVerifiedNonAnon()
                    || (request.auth != null && isSuperAdmin(wsId));
      allow update, delete: if request.auth != null && isSuperAdmin(wsId);
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /workspaces/{wsId}/users/{userId} {
      allow read: if request.auth != null;
      allow create: if isVerifiedNonAnon()
                    || (request.auth != null && isSuperAdmin(wsId));
      allow update, delete: if request.auth != null
                            && (isSuperAdmin(wsId)
                                || (isOrgAdmin(wsId)
                                    && resource.data.orgId == callerOrgId(wsId))
                                // Un utilisateur peut modifier SA PROPRE fiche (mot de passe,
                                // profil). On compare l'ID DU DOCUMENT (le segment de chemin
                                // `userId`, toujours présent) au `userId` du méta, en TEXTE
                                // des deux côtés (l'un est un nombre Date.now(), l'autre une
                                // chaîne). Avant, on comparait resource.data.id : si ce champ
                                // manquait ou différait du chemin, l'écriture était refusée
                                // (profil du locataire « toujours vide » après enregistrement).
                                || string(userId) == string(callerMeta(wsId).userId)
                                || string(resource.data.id) == string(callerMeta(wsId).userId));
    }

    // ── System settings ───────────────────────────────────────────────────────
    match /workspaces/{wsId}/settings/{settingId} {
      allow read: if request.auth != null && isStaff(wsId);
      allow write: if request.auth != null
                   && (isSuperAdmin(wsId)
                       || (settingId != 'systemSettings' && isOrgAdmin(wsId)));
    }

    // ── Mail queue (Firebase Trigger Email extension) ─────────────────────────
    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // ── Org-scoped collections ────────────────────────────────────────────────
    // Agences de l'utilisateur (toutes), lues depuis usersByUid.orgIds.
    function callerOrgIds(wsId) { return callerMeta(wsId).get('orgIds', []); }
    // Le document appartient-il à l'agence active OU à l'une des agences de
    // l'utilisateur ? (permet le rapport d'exercice « toutes agences »).
    function inCallerOrgs(wsId, docOrgId) {
      return docOrgId == callerOrgId(wsId) || (docOrgId in callerOrgIds(wsId));
    }
    function allowOrgDoc(wsId) {
      return request.auth != null
             && (isSuperAdmin(wsId) || isStaff(wsId))
             && (isSuperAdmin(wsId) || inCallerOrgs(wsId, orgIdOf(resource, request)));
    }

    // ── Portail locataire : un locataire ne lit QUE ses propres documents ──────
    function callerPersonId(wsId) { return callerMeta(wsId).get('personId', ''); }
    // Document existant rattaché au locataire courant (par tenantId).
    function ownTenantDoc(wsId) {
      return request.auth != null
             && callerPersonId(wsId) != ''
             && string(resource.data.tenantId) == string(callerPersonId(wsId));
    }
    // Document que le locataire courant CRÉE pour lui-même (ex. ticket).
    function ownTenantCreate(wsId) {
      return request.auth != null
             && callerPersonId(wsId) != ''
             && string(request.resource.data.tenantId) == string(callerPersonId(wsId));
    }

    match /workspaces/{wsId}/properties/{id}    { allow read, write: if allowOrgDoc(wsId); }
    match /workspaces/{wsId}/contracts/{id}     { allow read: if allowOrgDoc(wsId) || ownTenantDoc(wsId); allow write: if allowOrgDoc(wsId); }
    match /workspaces/{wsId}/payments/{id}      { allow read: if allowOrgDoc(wsId) || ownTenantDoc(wsId); allow write: if allowOrgDoc(wsId); }
    // Tickets de maintenance. Le locataire crée les siens et peut UNIQUEMENT
    // renseigner sa disponibilité et son avis sur le travail (champs limités) ;
    // tout le reste (statut, charge, technicien, clôture) reste au personnel.
    match /workspaces/{wsId}/tickets/{id} {
      allow read:   if allowOrgDoc(wsId) || ownTenantDoc(wsId);
      allow create: if allowOrgDoc(wsId) || ownTenantCreate(wsId);
      allow update: if allowOrgDoc(wsId)
                    || (ownTenantDoc(wsId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['tenantAvailability', 'tenantReview', 'updatedAt']));
      allow delete: if allowOrgDoc(wsId);
    }
    // Commentaires internes de maintenance — STRICTEMENT réservés au personnel
    // (le locataire ne doit jamais les lire).
    match /workspaces/{wsId}/ticketComments/{id} { allow read, write: if allowOrgDoc(wsId); }
    match /workspaces/{wsId}/inspections/{id}   { allow read: if allowOrgDoc(wsId) || ownTenantDoc(wsId); allow write: if allowOrgDoc(wsId); }
    match /workspaces/{wsId}/transactions/{id}  { allow read, write: if allowOrgDoc(wsId); }
    // Messagerie : le gérant (staff) voit toutes les conversations de son agence ;
    // le locataire ne lit/écrit QUE la sienne (conversation.tenantId == personId),
    // ce qui lui permet d'écrire au gérant et de recevoir ses réponses.
    match /workspaces/{wsId}/conversations/{id} {
      allow read:   if allowOrgDoc(wsId) || ownTenantDoc(wsId);
      allow create: if allowOrgDoc(wsId) || ownTenantCreate(wsId);
      allow update: if allowOrgDoc(wsId) || ownTenantDoc(wsId);
      allow delete: if allowOrgDoc(wsId);
    }
    match /workspaces/{wsId}/persons/{id}       { allow read, write: if allowOrgDoc(wsId); }
    match /workspaces/{wsId}/avenants/{id}      { allow read, write: if allowOrgDoc(wsId); }

    // ── OTP (2FA) ─────────────────────────────────────────────────────────────
    match /workspaces/{wsId}/otps/{userId} {
      allow read, write, delete: if request.auth != null;
    }

    // ── Security logs ─────────────────────────────────────────────────────────
    match /workspaces/{wsId}/security_logs/{logId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null && isSuperAdmin(wsId);
      allow update, delete: if false;
    }

    // ── Backups ───────────────────────────────────────────────────────────────
    match /workspaces/{wsId}/backups/{backupId} {
      allow read, write: if request.auth != null && isSuperAdmin(wsId);
    }
    match /workspaces/{wsId}/backups/{backupId}/{subCol}/{subDoc} {
      allow read, write: if request.auth != null && isSuperAdmin(wsId);
    }

    // ── Activity log ──────────────────────────────────────────────────────────
    match /workspaces/{wsId}/activityLog/{id} {
      allow read:  if request.auth != null && (isSuperAdmin(wsId) || isStaff(wsId));
      allow write: if request.auth != null && (isSuperAdmin(wsId) || isStaff(wsId));
    }

    // ── Tenants / owners ──────────────────────────────────────────────────────
    // Fiche locataire. Le personnel gère tout. Le locataire LIT sa fiche et peut
    // mettre à jour SES coordonnées (synchro profil), via un ensemble de champs
    // limité — il ne peut pas toucher orgId, loyer, statut, bien, etc.
    match /workspaces/{wsId}/tenants/{id} {
      allow read: if allowOrgDoc(wsId)
                  || (request.auth != null && callerPersonId(wsId) != '' && string(resource.data.id) == string(callerPersonId(wsId)));
      allow update: if allowOrgDoc(wsId)
                    || (request.auth != null && callerPersonId(wsId) != ''
                        && string(resource.data.id) == string(callerPersonId(wsId))
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['name','phone','whatsapp','email','profession','address','birthdate','gender','nationalId','avatar','updatedAt']));
      allow create, delete: if allowOrgDoc(wsId);
    }
    match /workspaces/{wsId}/owners/{id}        { allow read, write: if allowOrgDoc(wsId); }
    match /workspaces/{wsId}/monthClosures/{id} { allow read, write: if allowOrgDoc(wsId); }
    // Documents du dossier : le locataire lit les siens ET peut en AJOUTER /
    // SUPPRIMER (pièces jointes de son dossier). tenantId doit être présent sur
    // chaque document/morceau (voir TenantDocuments.jsx) pour ownTenantCreate.
    match /workspaces/{wsId}/tenantDocuments/{id} {
      allow read:   if allowOrgDoc(wsId) || ownTenantDoc(wsId);
      allow create: if allowOrgDoc(wsId) || ownTenantCreate(wsId);
      allow update: if allowOrgDoc(wsId);
      allow delete: if allowOrgDoc(wsId) || ownTenantDoc(wsId);
    }

    // ── Marketplace listings ───────────────────────────────────────────────────
    // Read: any authenticated user (includes anonymous — public marketplace)
    // Write: SUPER_ADMIN only
    // Update views/reactions: any authenticated user (anonymous included)
    match /workspaces/{wsId}/listings/{id} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && isSuperAdmin(wsId);
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['views', 'reactions', 'updatedAt']);
    }

    // ── Marketplace client profiles (visitors who register interest) ──────────
    match /workspaces/{wsId}/listingClients/{id} {
      allow read:  if request.auth != null && (isSuperAdmin(wsId) || isStaff(wsId));
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
                            && (isSuperAdmin(wsId) || request.auth.uid == resource.data.uid);
    }

    // ── Listing reactions ─────────────────────────────────────────────────────
    match /workspaces/{wsId}/listingReactions/{id} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Listing contact unlocks (paid access) ─────────────────────────────────
    // Any authenticated user (incl. anonymous) can create an unlock record.
    // Only SUPER_ADMIN can read/update/delete (for validation dashboard).
    match /workspaces/{wsId}/listingUnlocks/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && isSuperAdmin(wsId);
    }

    // ── Public marketplace config (readable by any auth incl. anonymous) ────────
    match /workspaces/{wsId}/publicSettings/{docId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && isSuperAdmin(wsId);
    }

    // ── Insurances ────────────────────────────────────────────────────────────
    match /workspaces/{wsId}/insurances/{id} { allow read, write: if allowOrgDoc(wsId); }

    // ── Apporteurs d'affaire ──────────────────────────────────────────────────
    match /workspaces/{wsId}/referrers/{id} { allow read, write: if allowOrgDoc(wsId); }

    // ── Prestataires (contractors) ────────────────────────────────────────────
    match /workspaces/{wsId}/prestataires/{id} { allow read, write: if allowOrgDoc(wsId); }

    // ── Budgets (monthly targets) ─────────────────────────────────────────────
    match /workspaces/{wsId}/budgets/{id} { allow read, write: if allowOrgDoc(wsId); }

    // ── Bordereaux de versement (org-scoped) ──────────────────────────────────
    match /workspaces/{wsId}/bordereaux/{id} { allow read, write: if allowOrgDoc(wsId); }

    // ── Taux de commission de gestion (org-scoped) ────────────────────────────
    match /workspaces/{wsId}/commissionRates/{id} { allow read, write: if allowOrgDoc(wsId); }

    // ── Rapports (org-scoped) — le filtrage "qui peut lire" est appliqué côté app ──
    match /workspaces/{wsId}/reports/{id} { allow read, write: if allowOrgDoc(wsId); }

    // Rapport annuel de gestion (commentaires du gérant par agence + exercice).
    match /workspaces/{wsId}/annualReports/{id} { allow read, write: if allowOrgDoc(wsId); }

    // Prospection commerciale (prospects, visites, mandats).
    match /workspaces/{wsId}/prospects/{id} { allow read, write: if allowOrgDoc(wsId); }

    // Minsouah Reconnaissance (distinctions locataires) — gestion par le personnel.
    // La lecture « sa propre distinction » par le locataire sera ajoutée avec l'espace locataire.
    match /workspaces/{wsId}/tenantAwards/{id} {
      allow read:  if allowOrgDoc(wsId)
                   || (request.auth != null && string(resource.data.tenantId) == string(callerMeta(wsId).get('personId', '')));
      allow write: if allowOrgDoc(wsId);
    }
    match /workspaces/{wsId}/awardCampaigns/{id} { allow read, write: if allowOrgDoc(wsId); }
    match /workspaces/{wsId}/awardAuditLogs/{id} { allow read, write: if allowOrgDoc(wsId); }
    // Critères paramétrables des distinctions (par agence).
    match /workspaces/{wsId}/recognitionSettings/{id} { allow read, write: if allowOrgDoc(wsId); }
    // Vérification publique d'un certificat (QR code) — lecture par tous, écriture par le personnel.
    match /workspaces/{wsId}/certificateVerify/{id} {
      allow read:  if true;
      allow write: if allowOrgDoc(wsId);
    }

    // ── Voucher number counters (org staff only) ──────────────────────────────
    match /workspaces/{wsId}/counters/{id} {
      allow read, write: if request.auth != null && (isSuperAdmin(wsId) || isStaff(wsId));
    }

    // ── Bordereau public verification (QR code — readable by anyone) ───────────
    match /workspaces/{wsId}/bordereauVerify/{id} {
      allow read:  if true;
      allow write: if request.auth != null && (isSuperAdmin(wsId) || isStaff(wsId));
    }

    // ── Quittance public verification (QR code — readable by anyone) ───────────
    match /workspaces/{wsId}/quittanceVerify/{id} {
      allow read:  if true;
      allow write: if request.auth != null && (isSuperAdmin(wsId) || isStaff(wsId));
    }

    // ── Tenant portals (public QR code portal — any authenticated or anon user can read) ──
    match /workspaces/{wsId}/tenantPortals/{id} {
      allow read:  if true;
      allow write: if request.auth != null && (isSuperAdmin(wsId) || isStaff(wsId));
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
