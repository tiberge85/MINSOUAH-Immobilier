rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────

    // Get the caller's role/orgId from the usersByUid lookup doc (written at login)
    function callerMeta(wsId) {
      return get(/databases/$(database)/documents/workspaces/$(wsId)/usersByUid/$(request.auth.uid)).data;
    }

    function callerRole(wsId) {
      return callerMeta(wsId).role;
    }

    function callerOrgId(wsId) {
      return callerMeta(wsId).orgId;
    }

    function isSuperAdmin(wsId) {
      return callerRole(wsId) == 'SUPER_ADMIN';
    }

    function isOrgAdmin(wsId) {
      return callerRole(wsId) in ['ORGANIZATION_ADMIN', 'ADMIN'];
    }

    function isStaff(wsId) {
      return callerRole(wsId) in ['ORGANIZATION_ADMIN', 'AGENT', 'ADMIN', 'MANAGER', 'CONCIERGE', 'TECHNICIAN', 'ACCOUNTANT'];
    }

    function sameOrg(wsId, docOrgId) {
      return callerOrgId(wsId) == docOrgId;
    }

    // ── usersByUid ───────────────────────────────────────────────────────────
    // Any authenticated user can read/write their own uid doc (written at login)
    match /workspaces/{wsId}/usersByUid/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Super admin can read all
      allow read: if request.auth != null && isSuperAdmin(wsId);
    }

    // ── SUPER_ADMIN global collections ───────────────────────────────────────
    // organizations and licenses are global — org admins read their own only
    match /workspaces/{wsId}/organizations/{orgId} {
      allow read:  if request.auth != null && (isSuperAdmin(wsId) || sameOrg(wsId, orgId));
      allow write: if request.auth != null && isSuperAdmin(wsId);
    }

    match /workspaces/{wsId}/licenses/{licId} {
      allow read:  if request.auth != null && (
        isSuperAdmin(wsId) ||
        resource.data.orgId == callerOrgId(wsId)
      );
      allow write: if request.auth != null && isSuperAdmin(wsId);
    }

    // ── Per-org user management ──────────────────────────────────────────────
    match /workspaces/{wsId}/users/{userId} {
      // Any authenticated user can read users (needed for cross-org login lookup)
      allow read: if request.auth != null;
      // Only org admins can write users in their own org; super admin can write any
      allow create: if request.auth != null && (
        isSuperAdmin(wsId) ||
        (isOrgAdmin(wsId) && request.resource.data.orgId == callerOrgId(wsId))
      );
      allow update, delete: if request.auth != null && (
        isSuperAdmin(wsId) ||
        (isOrgAdmin(wsId) && resource.data.orgId == callerOrgId(wsId)) ||
        // Users can update their own profile
        resource.data.id == callerMeta(wsId).userId
      );
    }

    // ── Org-scoped collections ───────────────────────────────────────────────
    // All other collections: staff can read/write within their org only
    function isOrgDoc(wsId, docOrgId) {
      return isStaff(wsId) && sameOrg(wsId, docOrgId);
    }

    match /workspaces/{wsId}/properties/{docId} {
      allow read, write: if request.auth != null && (
        isSuperAdmin(wsId) || isOrgDoc(wsId, resource == null ? request.resource.data.orgId : resource.data.orgId)
      );
    }

    match /workspaces/{wsId}/contracts/{docId} {
      allow read, write: if request.auth != null && (
        isSuperAdmin(wsId) || isOrgDoc(wsId, resource == null ? request.resource.data.orgId : resource.data.orgId)
      );
    }

    match /workspaces/{wsId}/payments/{docId} {
      allow read, write: if request.auth != null && (
        isSuperAdmin(wsId) || isOrgDoc(wsId, resource == null ? request.resource.data.orgId : resource.data.orgId)
      );
    }

    match /workspaces/{wsId}/tickets/{docId} {
      allow read, write: if request.auth != null && (
        isSuperAdmin(wsId) || isOrgDoc(wsId, resource == null ? request.resource.data.orgId : resource.data.orgId)
      );
    }

    match /workspaces/{wsId}/inspections/{docId} {
      allow read, write: if request.auth != null && (
        isSuperAdmin(wsId) || isOrgDoc(wsId, resource == null ? request.resource.data.orgId : resource.data.orgId)
      );
    }

    match /workspaces/{wsId}/transactions/{docId} {
      allow read, write: if request.auth != null && (
        isSuperAdmin(wsId) || isOrgDoc(wsId, resource == null ? request.resource.data.orgId : resource.data.orgId)
      );
    }

    match /workspaces/{wsId}/conversations/{docId} {
      allow read, write: if request.auth != null && (
        isSuperAdmin(wsId) || isOrgDoc(wsId, resource == null ? request.resource.data.orgId : resource.data.orgId)
      );
    }

    match /workspaces/{wsId}/persons/{docId} {
      allow read, write: if request.auth != null && (
        isSuperAdmin(wsId) || isOrgDoc(wsId, resource == null ? request.resource.data.orgId : resource.data.orgId)
      );
    }

    match /workspaces/{wsId}/avenants/{docId} {
      allow read, write: if request.auth != null && (
        isSuperAdmin(wsId) || isOrgDoc(wsId, resource == null ? request.resource.data.orgId : resource.data.orgId)
      );
    }

    // Settings / system data — org admins only
    match /workspaces/{wsId}/settings/{docId} {
      allow read: if request.auth != null && isStaff(wsId);
      allow write: if request.auth != null && (isSuperAdmin(wsId) || isOrgAdmin(wsId));
    }

    // ── Deny everything else ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
