rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isStaff() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in
        ['SUPER_ADMIN','ADMIN','MANAGER','ACCOUNTANT','TECHNICIAN'];
    }

    // Users collection — only own profile readable, admin can read all
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isAuth();
      allow update: if isOwner(userId) || isStaff();
      allow delete: if hasRole('SUPER_ADMIN') || hasRole('ADMIN');
    }

    // Chats — only participants can read/write
    match /chats/{chatId} {
      allow read, write: if isAuth() &&
        request.auth.uid in resource.data.participants;

      // Allow creating new chat if you're a participant
      allow create: if isAuth() &&
        request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuth();
        allow create: if isAuth() &&
          request.auth.uid == request.resource.data.senderId;
        allow update: if isAuth() &&
          request.auth.uid == resource.data.receiverId; // only receiver marks read
      }
    }

    // Notifications — only the target user can read/update their notifications
    match /notifications/{notifId} {
      allow read, update: if isAuth() &&
        request.auth.uid == resource.data.userId;
      allow create: if isStaff(); // only staff can create notifications
    }

    // Support tickets — staff can read all, users can read their own
    match /supportTickets/{ticketId} {
      allow read: if isStaff() ||
        (isAuth() && request.auth.uid == resource.data.createdBy);
      allow create: if isAuth();
      allow update: if isStaff();
      allow delete: if hasRole('SUPER_ADMIN') || hasRole('ADMIN');
    }
  }
}
